---
const { class: className = '', linked = true } = Astro.props;
const Tag = linked ? 'a' : 'span';
---
<Tag href={linked ? "/" : undefined} class:list={['brand', className]} aria-label={linked ? "devpush home" : undefined}>
  <svg viewBox="0 0 120 96" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M48 0H96L120 24V72H72V96H24L0 72V24H48V0ZM24 48V72H48V48H24ZM72 24V48H96V24H72Z" /></svg>
  <span>devpush</span>
</Tag>
