---
import play from 'lucide-static/icons/play.svg?raw';
---
<figure class="product-figure">
  <div class="product-stage">
    <a class="product-image-link product-image-light" href="/screenshots/deployment-light.jpg" aria-label="View the full-size deployment screenshot"><img class="product-image" src="/screenshots/deployment-light.jpg" width="1550" height="872" alt="devpush deployment details showing a successful production deployment, its server, branch and build logs." fetchpriority="high" /></a>
    <a class="product-image-link product-image-dark" href="/screenshots/deployment-dark.jpg" aria-label="View the full-size deployment screenshot"><img class="product-image" src="/screenshots/deployment-dark.jpg" width="1550" height="872" alt="devpush deployment details showing a successful production deployment, its server, branch and build logs." fetchpriority="high" /></a>
    <a class="btn demo-play" data-size="icon-lg" href="https://youtu.be/Ii9Tzttgif4" target="_blank" rel="noopener noreferrer" aria-label="Watch the devpush demo on YouTube (opens in a new tab)" title="Watch the demo"><Fragment set:html={play} /></a>
  </div>
</figure>
