---
import Logo from '../components/Logo.astro';
import { mainNavigation, footerNavigation } from '../content/navigation';
import menu from 'lucide-static/icons/menu.svg?raw';
import ThemeToggle from '../components/ThemeToggle.astro';
import basecoatJs from 'basecoat-css/all.min?url';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Deploy your apps with a git push.', description = 'devpush is an open-source deployment platform for Docker Compose. Deploy GitHub projects to your own servers, with domains, logs, backups and a public API.' } = Astro.props;
const { noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <title>{title} | devpush</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={`${title} | devpush`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="devpush" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const mode = localStorage.getItem('themeMode');
        document.documentElement.classList.toggle('dark', mode === 'dark' || (mode !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches));
      } catch {}
    </script>
    <script defer src={basecoatJs}></script>
  </head>
  <body class="marketing">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="header-sentinel" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap header-row">
        <Logo />
        <nav class="desktop-nav" aria-label="Main navigation">
          {mainNavigation.map(item => <a class="btn" data-variant="ghost" data-size="sm" href={item.href}>{item.label}</a>)}
        </nav>
        <div class="header-actions"><a class="btn" data-size="sm" href="/docs/self-hosting/">Get started</a>
          <div class="popover mobile-navigation" id="mobile-navigation"><button class="btn" data-variant="ghost" data-size="icon-sm" type="button" id="mobile-nav-trigger" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav-content"><Fragment set:html={menu} /></button><div id="mobile-nav-content" data-popover data-align="end" aria-hidden="true"><nav aria-label="Mobile navigation">{mainNavigation.map(item => <a class="btn" data-variant="ghost" data-size="sm" href={item.href}>{item.label}</a>)}</nav></div></div>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-brand"><Logo /><p>Open-source deployments.<br />Your apps. Your servers.</p></div>
      <nav class="footer-links" aria-label="Footer navigation">{footerNavigation.map(group => <div><h2>{group.label}</h2>{group.links.map(item => <a href={item.href}>{item.label}</a>)}</div>)}</nav>
      <div class="footer-bottom"><p>A project by <a href="https://rotsu.com/">Rotsu</a>. MIT licensed.</p><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><ThemeToggle /></div></div>
    </footer>
    <script>
      const sentinel = document.querySelector('#header-sentinel');
      const header = document.querySelector('.site-header');
      if (sentinel && header) new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      }).observe(sentinel);
    </script>
  </body>
</html>
