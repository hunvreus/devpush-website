---
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import basecoatJs from 'basecoat-css/all.min?url';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Deploy your apps with a git push.', description = 'devpush is an open-source deployment platform for Docker Compose. Deploy GitHub projects to your own servers, with domains, logs, backups and a public API.' } = Astro.props;
const { noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <title>{title} | devpush</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={`${title} | devpush`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="devpush" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const mode = localStorage.getItem('themeMode');
        document.documentElement.classList.toggle('dark', mode === 'dark' || (mode !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches));
      } catch {}
    </script>
    <script defer src={basecoatJs}></script>
  </head>
  <body class="marketing">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="header-sentinel" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap header-row">
        <Logo />
        <nav aria-label="Main navigation">
          <a class="btn" data-variant="ghost" data-size="sm" href="/#features">Features</a>
          <a class="btn" data-variant="ghost" data-size="sm" href="/docs/">Docs</a>
          <a class="btn nav-github" data-variant="ghost" data-size="sm" href="https://github.com/hunvreus/devpush">GitHub</a>
          <a class="btn header-cta" data-size="sm" href="/docs/getting-started/">Get started</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-brand"><Logo /><p>Deploy on your own terms.<br />Open source. Your servers.</p></div>
      <nav class="footer-links" aria-label="Footer navigation">
        <div><h2>Product</h2><a href="/#features">Features</a><a href="/self-hosting/">Self-hosting</a><a href="/docs/compose-deployments/">Docker Compose</a><a href="/docs/backups/">Backups</a><a href="/docs/accounts-and-teams/">Teams and permissions</a><a href="/docs/api-and-mcp/">API and MCP</a></div>
        <div><h2>Resources</h2><a href="/docs/">Documentation</a><a href="/docs/getting-started/">Quick start</a><a href="/docs/configuration/">Configuration</a><a href="https://github.com/hunvreus/devpush/blob/main/CHANGELOG.md">Changelog</a><a href="https://github.com/hunvreus/devpush/issues">Report an issue</a><a href="https://devpu.sh/chat">Community</a></div>
        <div><h2>Compare</h2><a href="/compare/coolify/">devpush vs Coolify</a><a href="/compare/dokploy/">devpush vs Dokploy</a><a href="/compare/vercel/">devpush vs Vercel</a><a href="/compare/render/">devpush vs Render</a></div>
        <div><h2>Project</h2><a href="/about/">About devpush</a><a href="/for/developers/">For developers</a><a href="/for/teams/">For teams</a><a href="/for/agencies/">For agencies</a><a href="https://github.com/hunvreus/devpush">Source code</a><a href="/about/#contributing">Contribute</a></div>
      </nav>
      <div class="footer-bottom"><p>Built by <a href="https://ronanberder.com">Ronan Berder</a>. MIT licensed.</p><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><ThemeToggle /></div></div>
    </footer>
    <script>
      const sentinel = document.querySelector('#header-sentinel');
      const header = document.querySelector('.site-header');
      if (sentinel && header) new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      }).observe(sentinel);
    </script>
  </body>
</html>
